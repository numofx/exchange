# Provider binaries: hundreds of MB, re-fetched by `terraform init`.
# The lock file next to this one IS committed, so init is reproducible.
.terraform/

# State and any variable file that might carry a secret.
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json
crash.log

# Saved plans (`-out=x.plan`) embed every resolved value, secrets included, and their text renderings and apply logs
# can too. They are working files for one apply; the commit that matters is variables.tf.
*.plan
*.plan.txt
*.apply.txt
