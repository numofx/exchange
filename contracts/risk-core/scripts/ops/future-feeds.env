# Template for /etc/numo/future-feeds.env (numo-future-feeds.service). NOT YET INSTALLED: nothing it
# names is deployed. Fill from risk-core/deployments/8453/CNGN_NOV30_2026_FUTURE.json on deploy day,
# copy to the box, and record both here and in OPS_BOX_CHANGES.md. Holds no secret.
CHAIN_ID=8453
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
INDEX_FEED=0xFaC420d160C7c219A72DC676971670980bAC20a5
FORWARD_FEED=<forwardFeed>
FUTURE_ASSET=<future>
FUTURE_SUB_ID=<subId: the expiry, e.g. 1796047200>
# Annual NGN-over-USD carry, 18dp: with no book the mark is index * (1 + CARRY * tau). Set from the
# same figure the deploy's INITIAL_MARK was checked against.
CARRY=<e.g. 200000000000000000>
# The KMS key's ARN (infra/aws: aws_kms_key.forward_signer). Not a secret: signing needs the role.
FORWARD_SIGNER_KMS_KEY_ID=<arn:aws:kms:us-east-1:...:key/...>
MARKETS_SERVICE_URL=https://api.numofx.com
FORWARD_TICK_MS=60000
FORWARD_MAX_BASIS_BPS=300
FORWARD_SAFETY_BPS=50
FORWARD_MARK_LATE_MS=7200000
