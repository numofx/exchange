# /etc/numo/future-feeds.env (numo-future-feeds.service), as installed on the box 2026-10-13 for
# USDC-cNGN-30NOV26: from risk-core/deployments/8453/MARGIN_ENGINE.json. A change here is copied to the
# box and recorded in OPS_BOX_CHANGES.md the same day. Holds no secret.
CHAIN_ID=8453
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
INDEX_FEED=0xFaC420d160C7c219A72DC676971670980bAC20a5
FORWARD_FEED=0xbB34Ee2435f050b6B7e46D6C3F8247EA77d6ffA6
FUTURE_ASSET=0xDCFa4Ee0772647aBd24E8592596b5fe4F001Bc19
FUTURE_SUB_ID=1796047200
# Annual NGN-over-USD carry, 18dp: with no book the mark is index * (1 + CARRY * tau). Set from the
# same figure the deploy's INITIAL_MARK was checked against: 11.8% (MARGIN_ENGINE.json carry).
CARRY=118000000000000000
# The KMS key's ARN (infra/aws: aws_kms_key.forward_signer). Not a secret: signing needs the role.
FORWARD_SIGNER_KMS_KEY_ID=arn:aws:kms:us-east-1:957261948743:key/4312f074-ddcb-4db3-89d5-02d042beaacd
MARKETS_SERVICE_URL=https://api.numofx.com
FORWARD_TICK_MS=60000
# Each side of the futures book must fill this much (USDC) before it sets the mark; else carry.
FORWARD_MIN_BOOK_DEPTH_USDC=2000
FORWARD_MAX_BASIS_BPS=300
FORWARD_SAFETY_BPS=50
FORWARD_MARK_LATE_MS=7200000
# A fixing sample every 5 minutes in the last hour; must be at most half the contract's 15-minute
# maxSampleGap (the keeper refuses to start otherwise).
FIXING_SAMPLE_INTERVAL_MS=300000
CLOSE_OUT_BATCH=20
