# The MarginEngine's liquidation keeper: services/perp-keeper with MANAGER = the engine. Watches every account
# under the engine, starts auctions on those under maintenance and bids from its own funding account under
# the engine; DutchAuction settles each account through the engine first (settlePerpsWithIndex, which
# realises the future's VM). The perp SRM's keeper (numo-perp-keeper-ssm.service) watches the SRM only.
#
# Installed 2026-10-13 in DRY_RUN (OPS_BOX_CHANGES.md). The MarginEngine enable batch's keeper gate (propose_margin_engine_batch.py) refuses
# until this runs out of DRY_RUN with a funding account holding a full futures side's IM (3,750 USDC).
#
# Its own key (/numo/keeper/engine_keeper_key, under the path the box may already read) and its own
# funding account: one EOA shared with the perp keeper would race it for nonces. Runs from
# /home/ec2-user/exchange-future, never exchange-perp (the live perp keeper's checkout).
#
# Before starting:
#   - SSM /numo/keeper/engine_keeper_key: a fresh key, its EOA funded with gas;
#   - its funding account: SubAccounts.createAccount(engine keeper EOA, MarginEngine) from that EOA (not the
#     app or SubAccountCreator, which leave it held by Matching), then a cash deposit;
#   - /etc/numo/engine-keeper.env from engine-keeper.env with KEEPER_ACCOUNT filled in.
#
# Install: (cd /home/ec2-user/exchange-future && pnpm install --frozen-lockfile --filter perp-keeper... && pnpm --filter perp-keeper build)
#          cp contracts/risk-core/scripts/ops/numo-engine-keeper.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now numo-engine-keeper
# and record it in OPS_BOX_CHANGES.md the same day.
[Unit]
Description=Numo MarginEngine liquidation keeper (Base mainnet, SSM secrets)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/exchange-future/services/perp-keeper
EnvironmentFile=/etc/numo/engine-keeper.env
ExecStart=/bin/bash -c 'export KEEPER_KEY="$(aws ssm get-parameter --name /numo/keeper/engine_keeper_key --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")" RPC_URL="$(aws ssm get-parameter --name /numo/feeds/rpc_url --with-decryption --query Parameter.Value --output text --region "$AWS_REGION")" ALERT_WEBHOOK_URL="$(aws ssm get-parameter --name /numo/feeds/alert_webhook_url --with-decryption --query Parameter.Value --output text --region "$AWS_REGION" 2>/dev/null || true)" ALERT_PREFIX="[engine] " && exec /usr/bin/node dist/main.js'
Environment=AWS_REGION=us-east-1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
