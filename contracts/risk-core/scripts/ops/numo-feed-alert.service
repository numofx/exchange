# One-shot feed staleness check; scheduled by numo-feed-alert.timer (every minute). Wrapped in
# run-with-heartbeat.sh, so a run that does not happen pages too.
#
# Rewritten 2026-10-09 to what the ops box actually runs: this file had said User=numo and
# /home/numo/risk-core, which the box has never used.
[Unit]
Description=Numo feed staleness check

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/exchange/contracts/risk-core
ExecStart=/home/ec2-user/exchange/contracts/risk-core/scripts/ops/run-with-heartbeat.sh feed-alert /home/ec2-user/exchange/contracts/risk-core/scripts/ops/run-with-ssm.sh /usr/bin/python3 scripts/ops/check_feed_staleness.py
Environment=AWS_REGION=us-east-1
