# Template for /etc/numo/engine-keeper-v2.env (numo-engine-keeper-v2.service): the liquidation keeper for MarginEngine v2.
# As installed on the box 2026-10-28 (OPS_BOX_CHANGES.md). Non-secret: KEEPER_KEY, RPC_URL and ALERT_WEBHOOK_URL come
# from SSM in the unit's ExecStart. Addresses from risk-core deployments/8453/MARGIN_ENGINE_V2.json. v1's engine keeper
# (engine-keeper.env) moved here that day and is disabled: v1's USDC-cNGN-30NOV26 has no liquidator until it settles.
#
# Per engine, not per series: a v2 series is one more address in FUTURE.
CHAIN_ID=8453
# The keeper's funding account under v2, created by its EOA 0x753f…f83b (SubAccounts.createAccount(eoa, 0x0705…0950))
# and funded with v1 #33's 5,000 USDC cash, 2026-10-28.
KEEPER_ACCOUNT=38
SUB_ACCOUNTS=0x7019244E25FA416e6Ca2ed2F3cA25277aef72843
MANAGER=0x0705219a1594d5Fc5dC2573da4082cAf3e1B0950
AUCTION=0xd07176B006cE8246e930d37b8bc44B1154f8c4cE
CASH=0xA74E49b4Ed7cb176bc02ef4D8a1A3240C9aD4272
# No PERP: v2 lists none. Comma-separated, one per series: cNGN-30NOV26, then EURC-30NOV26 (EURC_FUTURE_V2.json,
# added 2026-10-30 after its setup landed).
FUTURE=0xcACEe66ad41fD1472a47D7D5Fe372FFbFac9AA75,0x6Ff7084D6F1760a57b9475a41F54b12279cD7744
POOL_ACCOUNT=37
SECURITY_MODULE_ACCOUNT=21
# v2's deploy (2026-10-27, blocks 53164124–53164160): no account was under it before.
START_BLOCK=53164124
DRY_RUN=false
MAX_BID_USD=1500
# 9464 is the perp keeper's, 9465 v1's engine keeper's.
HEALTH_PORT=9466
HEALTH_HOST=127.0.0.1
MIN_KEEPER_ETH=0.002
# A full futures side's IM at the enable cap: 15 contracts x 1,000,000 cNGN x ~0.000743 x 25% = ~2,790 USDC. It moves
# with the mark; propose_margin_engine_v2_batch.py's keeper gate re-reads it (engine_keeper_min_cash).
MIN_KEEPER_CASH_USD=2800
CNGN_ESCROW=0x37c976bb5d4887a714ef19AF6B83e34fe2f37c98
# The engine's market-1 spot feed (getMarketFeeds(1)[0]), USDC per cNGN: v2 has no perp index to price cNGN by.
CNGN_SPOT_FEED=0xFaC420d160C7c219A72DC676971670980bAC20a5
MAX_CNGN_INVENTORY=8000000
# EURC (v2 market 2): the escrow is whitelisted for v2 at cap 0 until `eurc-cap` (margin-engine-v2.md, step 6). Set now so
# a keeper paid in EURC prices and limits it; revisit MAX_EURC_INVENTORY with the eurc-cap step.
EURC_ESCROW=0xfD2AFbF4eF6E7a7f34A04D16Ff6da249Ca086cD9
EURC_SPOT_FEED=0xaaE62Ae5df3747B8f43F895561043FB77D97C435
EURC_HAIRCUT_BPS=200
MAX_EURC_INVENTORY=40000
