# Template for /etc/numo/engine-keeper.env (numo-engine-keeper.service), as installed 2026-10-13. Non-secret: KEEPER_KEY,
# RPC_URL and ALERT_WEBHOOK_URL come from SSM in the unit's ExecStart. Addresses from risk-core deployments/8453
# MARGIN_ENGINE.json and CNGN_PERP_STACK.json. Installed in DRY_RUN 2026-10-13 17:39 UTC, live since that evening.
CHAIN_ID=8453
# The engine keeper's funding account: under the MarginEngine, owned by the engine keeper EOA 0x753f…f83b
# (created 2026-10-13, funded with 5,000 USDC from account 23).
KEEPER_ACCOUNT=33
SUB_ACCOUNTS=0x7019244E25FA416e6Ca2ed2F3cA25277aef72843
MANAGER=0xA19E296021c9DF25b90D96C2A0793CC3D0800758
AUCTION=0xd07176B006cE8246e930d37b8bc44B1154f8c4cE
CASH=0xA74E49b4Ed7cb176bc02ef4D8a1A3240C9aD4272
PERP=0xC74EfC8B4808803dBCF439E76Fde076d56625b8E
FUTURE=0xDCFa4Ee0772647aBd24E8592596b5fe4F001Bc19
POOL_ACCOUNT=31
SECURITY_MODULE_ACCOUNT=21
# The engine's deploy block (MarginEngine, 2026-10-13): no account was under it before.
START_BLOCK=52549918
DRY_RUN=false
MAX_BID_USD=1500
# 9464 is the perp keeper's.
HEALTH_PORT=9465
HEALTH_HOST=127.0.0.1
MIN_KEEPER_ETH=0.002
# The full futures side's IM (3,750 USDC): the enable gate's floor.
MIN_KEEPER_CASH_USD=3750
CNGN_ESCROW=0x37c976bb5d4887a714ef19AF6B83e34fe2f37c98
MAX_CNGN_INVENTORY=8000000
# EURC (engine market 2, configured 2026-10-25): risk-core deployments/8453/EURC_SPOT.json "escrow" and "spotFeed".
# Set both or neither: the keeper refuses to start with one. Every bid takes a share of ALL an account's
# assets, so once EURC deposits open the keeper is paid in EURC by any account holding it; without these
# lines it bids those accounts with no EURC haircut and no EURC limit.
EURC_ESCROW=0xfD2AFbF4eF6E7a7f34A04D16Ff6da249Ca086cD9
EURC_SPOT_FEED=0xaaE62Ae5df3747B8f43F895561043FB77D97C435
EURC_HAIRCUT_BPS=200
# MAX_EURC_INVENTORY is whole EURC: the escrow's cap (40,000, set 2026-10-25); the enable gate refuses more or unset.
MAX_EURC_INVENTORY=40000
