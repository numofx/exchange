# Template for /etc/numo/engine-keeper.env (numo-engine-keeper.service). NOT YET INSTALLED. Non-secret: KEEPER_KEY,
# RPC_URL and ALERT_WEBHOOK_URL come from SSM in the unit's ExecStart. Addresses from risk-core deployments/8453
# MARGIN_ENGINE.json and CNGN_PERP_STACK.json. Ships in DRY_RUN: watch its decisions, then flip it.
CHAIN_ID=8453
# The engine keeper's funding account: under the MarginEngine, owned by the engine keeper EOA (fill in).
KEEPER_ACCOUNT=<engine keeper funding account>
SUB_ACCOUNTS=0x7019244E25FA416e6Ca2ed2F3cA25277aef72843
MANAGER=0xA19E296021c9DF25b90D96C2A0793CC3D0800758
AUCTION=0xd07176B006cE8246e930d37b8bc44B1154f8c4cE
CASH=0xA74E49b4Ed7cb176bc02ef4D8a1A3240C9aD4272
PERP=0xC74EfC8B4808803dBCF439E76Fde076d56625b8E
FUTURE=0xDCFa4Ee0772647aBd24E8592596b5fe4F001Bc19
POOL_ACCOUNT=31
SECURITY_MODULE_ACCOUNT=21
# The engine's deploy block (MarginEngine, 2026-10-13): no account was under it before.
START_BLOCK=52549918
DRY_RUN=true
MAX_BID_USD=1500
# 9464 is the perp keeper's.
HEALTH_PORT=9465
HEALTH_HOST=127.0.0.1
MIN_KEEPER_ETH=0.002
# The full futures side's IM (3,750 USDC): the enable gate's floor.
MIN_KEEPER_CASH_USD=3750
CNGN_ESCROW=0x37c976bb5d4887a714ef19AF6B83e34fe2f37c98
MAX_CNGN_INVENTORY=8000000
