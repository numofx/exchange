# As installed at /etc/numo/perp-pager.env on the ops box (i-06107393582d770e3), recorded 2026-10-10. Holds no secret: keys and
# tokens come from SSM in the unit's run-with-ssm*.sh. Edit here, then copy to the box.
# USDCcNGN-PERP pager (check_perp_pager.py). Secrets come from SSM via run-with-ssm-pager.sh.
KEEPER_HEALTH_URL=http://127.0.0.1:9464/health
PERP_INDEX_STATUS_FILE=/var/lib/numo/perp-index-status.json
PAGER_STATE_FILE=/var/lib/numo/perp-pager-state.json
KEEPER_EOA=0xdE57b9E91358BB2f58DB7A7D588533f996373f18
KEEPER_ACCOUNT=23
# MarginEngine v2's liquidation keeper (numo-engine-keeper-v2, #258), on the box since 2026-10-28: the pager pages
# keeper-unhealthy-v2 / insolvent-account-v2 for it. v2's futures are read from
# deployments/8453/MARGIN_ENGINE_V2.json by default (FUTURE_V2_ARTIFACTS, comma-separated, adds a series).
ENGINE_V2_KEEPER_HEALTH_URL=http://127.0.0.1:9466/health
# Every v2 series, one artifact each, from the pager's own checkout: cNGN-30NOV26 and EURC-30NOV26 (2026-10-30).
FUTURE_V2_ARTIFACTS=/home/ec2-user/exchange-pager/contracts/risk-core/deployments/8453/MARGIN_ENGINE_V2.json,/home/ec2-user/exchange-pager/contracts/risk-core/deployments/8453/EURC_FUTURE_V2.json
# Gas watch (replaces the code default, so it lists the executor and perp relayer too; KEEPER_EOA still adds the perp
# keeper). Added 2026-10-30: the three forward relayers (each ~0.00003 ETH/day at a mark an hour; floor 0.0003, about 10
# days) and MarginEngine v2's engine keeper 0x753f (idle burn ~0; floor 0.002, ~100 liquidation cycles).
GAS_WATCH=executor=0xF68ebcC8934B068655E1A4367Ba6C0e564678703:0.002,relayer=0xC9F1FfdEd29f7051538ad3a72729C3d07F920FDc:0.003,forward-relayer-v1=0xE5b8541dC2558f3db65aF88A2374e464AE4ae6de:0.0003,forward-relayer-v2-cngn=0x3ACeFDe146161D1b9ca2fdB8a3B38122818d763f:0.0003,forward-relayer-v2-eurc=0xEEa45ea4f68cb62b5eDe84E1d9F82F6d253C5321:0.0003,engine-keeper-v2=0x753fCC2342F180e1B9B0BfFFEb21f4E00741f83b:0.002
