# /etc/numo/future-feeds-v2-eurc-30nov26.env (numo-future-feeds-v2@eurc-30nov26.service), for EURC-30NOV26 on
# MarginEngine v2: from risk-core/deployments/8453/EURC_FUTURE_V2.json (deployed 2026-10-30, setup landed the same
# day). The box's copy adds DRY_RUN. A change here is copied to the box and recorded in OPS_BOX_CHANGES.md the same
# day. Holds no secret.
CHAIN_ID=8453
FUTURE_VERSION=v2
BASE_SYMBOL=EURC
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
# The EURC spot feed (USD per EURC, Chainlink EURC/USD), v2 market 2's spot feed: read as is.
INDEX_FEED=0xaaE62Ae5df3747B8f43F895561043FB77D97C435
FORWARD_FEED=0xB67fCd9A66efc3C12Be3Ea2bBB97385004394d14
FUTURE_ASSET=0x6Ff7084D6F1760a57b9475a41F54b12279cD7744
# The expiry, 2026-11-30 16:00 UTC: two hours after cNGN-30NOV26, so the two series do not share a sub id.
FUTURE_SUB_ID=1796054400
# MarginEngine v2. Its VM pool is account #37, cash only, shared with cNGN-30NOV26.
FUTURE_MANAGER=0x0705219a1594d5Fc5dC2573da4082cAf3e1B0950
# Annual EUR-over-USD carry, 18dp, signed: -1.5% (an assumption, ECB ~2% against fed funds ~3.5%), a forward
# premium. The figure the deploy's initial mark was checked against (EURC_FUTURE_V2.json carry).
CARRY=-15000000000000000
# The forward KMS key (0xd65F…3650), the feed's only signer: each feed's EIP-712 domain binds signatures to it.
FORWARD_SIGNER_KMS_KEY_ID=arn:aws:kms:us-east-1:957261948743:key/4312f074-ddcb-4db3-89d5-02d042beaacd
# A relayer of this instance's own (run-with-ssm-forward.sh): sharing cNGN's would race it for nonces.
FORWARD_RELAYER_SSM_NAME=forward_relayer_key_v2_eurc
MARKETS_SERVICE_URL=https://api.numofx.com
FORWARD_TICK_MS=60000
# Each side of the futures book must fill this much (USDC) before it sets the mark; else carry. A contract is 1,000
# EURC, ~$1,120: about 2 contracts a side.
FORWARD_MIN_BOOK_DEPTH_USDC=2000
# The contract's own band (3% narrowing to 0.5% over 14 days) is read from the chain and clamps every mark.
FORWARD_MAX_BASIS_BPS=300
FORWARD_SAFETY_BPS=50
FORWARD_MARK_LATE_MS=7200000
FIXING_SAMPLE_INTERVAL_MS=300000
CLOSE_OUT_BATCH=20
SETTLE_PER_TICK=10
