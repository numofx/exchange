# The cNGN future's keeper (services/perp-feeds, dist/forward-main.js). Until last trade it signs the
# forward into the future's LyraForwardFeed and calls FutureAsset.pullMark, about hourly. In the
# fixing window it records index samples, after expiry it fixes the settlement price (or alerts that
# the vault's bounded fallback is needed), and once settled it closes out every account still holding.
#
# Installed 2026-10-13 for USDC-cNGN-30NOV26 (MARGIN_ENGINE.json); see OPS_BOX_CHANGES.md.
#
# Its own checkout, /home/ec2-user/exchange-future, not exchange-perp: numo-perp-feeds and
# numo-perp-keeper run from exchange-perp's dist, and building this there would replace the code they
# pick up on their next restart. Each checkout is moved on its own, when its service is.
#
# Its own unit, signer and relayer, apart from numo-perp-feeds: the forward key must not be the index
# key (the index band is what bounds a bad forward), and one failing must not stop the other.
#
# Before starting:
#   - the KMS key exists (infra/aws: forward_signer_kms_enabled) and its address is the forward feed's
#     only signer;
#   - /numo/feeds/forward_relayer_key holds a funded relayer, watched by check_signer_balance.py;
#   - /etc/numo/future-feeds.env holds the addresses from the deploy artifact (future-feeds.env).
#
# Install: git clone https://github.com/numofx/exchange /home/ec2-user/exchange-future && git -C ... checkout <sha>
#          (cd /home/ec2-user/exchange-future && pnpm install --filter perp-feeds... && pnpm --filter @numo/kms-signer build && pnpm --filter perp-feeds build)
#          cp contracts/risk-core/scripts/ops/numo-future-feeds.service /etc/systemd/system/
#          systemctl daemon-reload && systemctl enable --now numo-future-feeds
[Unit]
Description=Numo cNGN future keeper: forward marks, fixing, close-out (Base mainnet, KMS signer, SSM relayer)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/exchange-future/services/perp-feeds
EnvironmentFile=/etc/numo/future-feeds.env
ExecStart=/home/ec2-user/exchange-future/contracts/risk-core/scripts/ops/run-with-ssm-forward.sh /usr/bin/node dist/forward-main.js
Environment=AWS_REGION=us-east-1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
