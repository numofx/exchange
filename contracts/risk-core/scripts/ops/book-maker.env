# As installed at /etc/numo/book-maker.env on the ops box (numo-book-maker.service). Holds no secret: the MM key
# (/numo/exchange/mm_private_key) and RPC (/numo/exchange/mm_rpc_url) come from SSM in run-with-ssm-book-maker.sh.
# Every variable: market-maker docs/book-maker.md.
MM_BOOK_ADDRESS=0x8Fc63DcB3a173aAF5d2de0F42648D908A519d456
MM_BOOK_MARKET_ID=1
MM_BOOK_ACCOUNT_ID=56
MM_BOOK_REFERENCE_MARKET_ID=2
# The canary's curve (2026-11-16): 20 EURC at the best level, 40 more 50 ticks behind, each side; ~+/-2.7 bps.
MM_BOOK_CURVE=20@0,40@50
MM_BOOK_HALF_SPREAD_TICKS=300
MM_BOOK_TTL_SECONDS=3600
MM_BOOK_REFRESH_SECONDS=1800
MM_BOOK_REPRICE_TICKS=20
MM_BOOK_CUTOFF_SECONDS=3600
MM_BOOK_MAX_DIVERGENCE_BPS=50
MM_BOOK_POLL_SECONDS=5
MM_BOOK_DRY_RUN=false
MM_SIGNER_BACKEND=local
