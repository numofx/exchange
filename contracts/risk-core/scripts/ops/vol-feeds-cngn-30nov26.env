# /etc/numo/vol-feeds.env (numo-vol-feeds.service), for cNGN options at 30NOV26 on MarginEngine v2. NOT YET INSTALLED.
# Holds no secret. VOL_FEED and VOL_SIGNER_KMS_KEY_ID are left empty on purpose: the publisher refuses to start
# until they are filled from CNGN_OPTIONS_V2.json and the vol key's KMS id.
CHAIN_ID=8453
DRY_RUN=true
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
# CNGN_OPTIONS_V2.json volFeed
VOL_FEED=
# The cNGN-30NOV26 future's LyraForwardFeed and the cNGN index (MARGIN_ENGINE_V2.json)
FORWARD_FEED=0x24474D8A95EB8Be9070ede58E09405B410c277Df
INDEX_FEED=0xFaC420d160C7c219A72DC676971670980bAC20a5
ENGINE=0x0705219a1594d5Fc5dC2573da4082cAf3e1B0950
MARKET_ID=1
# 2026-11-30 14:00 UTC, the future's expiry
EXPIRY=1796047200
VOL_SIGNER_KMS_KEY_ID=
VOL_RELAYER_SSM_NAME=vol_relayer_key
# The hand-set surface, approved as the launch values 2026-11-01 (the fork test's): 40% ATM, b = 2x ATM variance, skew
# -0.5 (the devaluation wing dearer: ~49% at 0.8x the forward, ~41% at 1.2x), curvature 0.1. A change is a governance
# change: commit, then copy.
VOL_ATM=400000000000000000
VOL_B_MULT=2000000000000000000
VOL_RHO=-500000000000000000
VOL_SIGMA=100000000000000000
# Degrade, not halt (approved 2026-11-01): confidence 0.5, under the engine's option threshold (0.8 in the batch;
# checked at startup), and ATM at least 80%.
VOL_DEGRADED_CONFIDENCE=500000000000000000
VOL_DEGRADED_ATM_FLOOR=800000000000000000
INDEX_STATUS_FILE=/var/lib/numo/perp-index-status.json
INDEX_STEP_AUDIT_FILE=/var/lib/numo/perp-index-steps.jsonl
VOL_STATUS_FILE=/var/lib/numo/vol-status.json
VOL_TICK_MS=60000
VOL_PUBLISH_INTERVAL_MS=300000
