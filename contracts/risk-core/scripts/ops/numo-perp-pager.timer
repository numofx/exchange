# Every minute: the index heartbeat is 20 minutes and the page fires at 16, so a minute's lag leaves
# the operator ~3 minutes before the market halts.
[Unit]
Description=Numo USDCcNGN-PERP pager check every minute

[Timer]
OnBootSec=1min
OnUnitActiveSec=1min
AccuracySec=5s
Persistent=true

[Install]
WantedBy=timers.target
