# /etc/numo/future-feeds-v2-cngn-30nov26.env (numo-future-feeds-v2@cngn-30nov26.service), for cNGN-30NOV26 on
# MarginEngine v2: from risk-core/deployments/8453/MARGIN_ENGINE_V2.json. NOT INSTALLED: a template until the v2
# forward keeper goes on the box (#258). A change here is copied to the box and recorded in OPS_BOX_CHANGES.md
# the same day. Holds no secret.
#
# A v2 series is config only: an EURC-30NOV26 instance is a copy of this file with its own FORWARD_FEED,
# FUTURE_ASSET, INDEX_FEED (the EURC spot feed), CARRY, BASE_SYMBOL and relayer, installed as
# numo-future-feeds-v2@eurc-30nov26.
CHAIN_ID=8453
FUTURE_VERSION=v2
BASE_SYMBOL=cNGN
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
# The cNGN spot feed (USDC per cNGN), v1's index too: read as is.
INDEX_FEED=0xFaC420d160C7c219A72DC676971670980bAC20a5
FORWARD_FEED=0x24474D8A95EB8Be9070ede58E09405B410c277Df
FUTURE_ASSET=0xcACEe66ad41fD1472a47D7D5Fe372FFbFac9AA75
# The expiry, 2026-11-30 14:00 UTC: the same sub id as v1's USDC-cNGN-30NOV26, on a different FUTURE_ASSET.
FUTURE_SUB_ID=1796047200
# MarginEngine v2. Its VM pool is account #37, cash only.
FUTURE_MANAGER=0x0705219a1594d5Fc5dC2573da4082cAf3e1B0950
# Annual NGN-over-USD carry, 18dp: with no book the mark is index / (1 + CARRY * tau). 11.8%, the figure the
# deploy's INITIAL_MARK was checked against (MARGIN_ENGINE_V2.json carry).
CARRY=118000000000000000
# v1's forward KMS key (0xd65F…3650), the v2 feed's only signer: each feed's EIP-712 domain binds signatures to it.
FORWARD_SIGNER_KMS_KEY_ID=arn:aws:kms:us-east-1:957261948743:key/4312f074-ddcb-4db3-89d5-02d042beaacd
# A relayer of this instance's own (run-with-ssm-forward.sh): sharing v1's would race it for nonces.
FORWARD_RELAYER_SSM_NAME=forward_relayer_key_v2_cngn
MARKETS_SERVICE_URL=https://api.numofx.com
FORWARD_TICK_MS=60000
# Each side of the futures book must fill this much (USDC) before it sets the mark; else carry. A v2 contract is
# 1,000,000 cNGN, ~$720 at 0.00072: about 3 contracts a side.
FORWARD_MIN_BOOK_DEPTH_USDC=2000
FORWARD_MAX_BASIS_BPS=300
FORWARD_SAFETY_BPS=50
FORWARD_MARK_LATE_MS=7200000
FIXING_SAMPLE_INTERVAL_MS=300000
CLOSE_OUT_BATCH=20
SETTLE_PER_TICK=10
