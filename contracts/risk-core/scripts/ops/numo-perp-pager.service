# Pages the operator's phone for USDCcNGN-PERP conditions that may need the guardian: a feed halt,
# an unhealthy keeper, a SecurityModule payout, an insolvent account (check_perp_pager.py). Mirrors
# every page to Slack. KEEPER_HEALTH_URL comes from /etc/numo/perp-pager.env. Paired with
# numo-perp-pager.timer.
[Unit]
Description=Numo USDCcNGN-PERP pager check

[Service]
# Runs from its own checkout, /home/ec2-user/exchange-pager, kept at main (since 2026-10-13; before, exchange-perp, whose
# af584bc predates the MarginEngine and read no future). Not exchange-perp: that is the live perp keeper's checkout,
# and updating the pager must not move the keeper's code. Not /home/ec2-user/exchange (an older, dirty checkout).
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/exchange-pager/contracts/risk-core
EnvironmentFile=/etc/numo/perp-pager.env
ExecStart=/home/ec2-user/exchange-pager/contracts/risk-core/scripts/ops/run-with-ssm-pager.sh /usr/bin/python3 scripts/ops/check_perp_pager.py
Environment=AWS_REGION=us-east-1
