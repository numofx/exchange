# /etc/numo/future-feeds-v3-eurc-31dec26.env (numo-future-feeds-v3@eurc-31dec26.service): EURC-31DEC26, the second series
# on the v3 future, expiry 2026-12-31 15:00 UTC (eurc-31dec26-listing-runsheet.md, L2/L5). Everything but the series and
# the relayer is EURC-30NOV26's (future-feeds-v3-eurc-30nov26.env). Not yet installed; the series is not listed yet
# (L4). Install with DRY_RUN=true first. A change here is copied to the box and recorded in OPS_BOX_CHANGES.md the same day.
# Holds no secret: the relayer and the Data Streams credentials come from SSM through run-with-ssm-forward.sh.
CHAIN_ID=8453
FUTURE_VERSION=v3
BASE_SYMBOL=EURC
DATA_SUBMITTER=0xe0C06DD245f1e8C8bC516c66C66e64648987F912
# EurcIndexFeed: Data Streams EURC/USD over USDC/USD through StreamsIndexAdapter 0x9E9a…FfEB. Fresh only while this
# keeper posts reports.
INDEX_FEED=0x56582804c815A17c806d140e8554fA36777B24D9
FORWARD_FEED=0x401D6027F74aA5B37c49dDC4539975e0dE33d8e4
FUTURE_ASSET=0xC350243c1d07Ff598770ECe12323799D2EFbB227
FUTURE_SUB_ID=1798729200
FUTURE_MANAGER=0x0705219a1594d5Fc5dC2573da4082cAf3e1B0950
CARRY=-15000000000000000
# The forward KMS key (0xd65F…3650), the v3 forward feed's only signer, as for the v2 EURC series.
FORWARD_SIGNER_KMS_KEY_ID=arn:aws:kms:us-east-1:957261948743:key/4312f074-ddcb-4db3-89d5-02d042beaacd
# A relayer of this instance's own: two instances on one key collide on nonces. The canary's, idle since it settled
# (0x35eeBd8E94F9c4a6b13EBa9fD676f7d0fDa8bDD5): fund it first (L3). After 30NOV26's keeper is disabled, this instance may
# move to forward_relayer_key_v3_eurc. Both instances post Data Streams reports to the shared adapter until then.
FORWARD_RELAYER_SSM_NAME=forward_relayer_key_v3_eurc_canary
MARKETS_SERVICE_URL=https://api.numofx.com
# 15 s: the keeper requires STREAMS_REFRESH_S + 2 x FORWARD_TICK_MS within indexMaxAge (20 + 30 <= 60).
FORWARD_TICK_MS=15000
FORWARD_MIN_BOOK_DEPTH_USDC=2000
FORWARD_MAX_BASIS_BPS=300
FORWARD_SAFETY_BPS=50
FORWARD_MARK_LATE_MS=7200000
# Reports every 20 s against a 60 s index age; a sample every 30 s against the 2-minute gap (the keeper refuses more
# than half the gap).
STREAMS_REFRESH_S=30
FIXING_SAMPLE_INTERVAL_MS=30000
CLOSE_OUT_BATCH=20
SETTLE_PER_TICK=10
# L5: true for the first run (read the first forward mark in the log), then false and restart. The keeper defaults to false.
DRY_RUN=false
