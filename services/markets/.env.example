APP_ENV=dev
API_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matching?sslmode=disable
MATCHER_POLL_INTERVAL=250ms

CHAIN_RPC_URL=
CHAIN_ID=
MATCHING_ADDRESS=
ENFORCE_MATCHING_CUSTODY=true
ENFORCE_ACTION_DATA_INVARIANTS=true
# The one TradeModule this venue settles on. Every submitted order is pinned to it, so an
# order signed for any other module is rejected at submit rather than after it has crossed.
# Required in production.
TRADE_MODULE_ADDRESS=
CNGN_SPOT_ASSET_ADDRESS=
# The asset TRADE_MODULE_ADDRESS settles the quote leg in, i.e. its quoteAsset(). Required
# for the pre-trade funding check: a buyer must hold notional + taker fee, because
# TradeModule puts the fee in the same batch and the manager sees one net delta.
#
#   cash-quoted module   -> the CashAsset          (settlement ledger; can go negative)
#   wrapped-quote module -> a WrappedERC20Asset    (1:1 token-backed; cannot go negative)
#
# Must be changed in the same commit as TRADE_MODULE_ADDRESS. Reading the wrong contract is
# worse than reading none: every buyer is judged against a ledger the trade never touches.
# Falls back to CASH_ASSET_ADDRESS when unset, so an existing deployment needs no change.
QUOTE_ASSET_ADDRESS=
# Legacy name for the above, kept as the fallback. Prefer QUOTE_ASSET_ADDRESS.
CASH_ASSET_ADDRESS=
# Unset quote asset disables the check (matching still works; underfunded buys just revert
# on chain instead of being skipped).
ENFORCE_FUNDING_CHECK=true

EXPECTED_ORDER_OWNER=
EXPECTED_ORDER_SIGNER=

EXECUTOR_URL=http://localhost:3001/match
EXECUTOR_MANAGER_DATA=0x
CANCEL_PROTECTED_ORDER_ID_PREFIXES=validation:,smoke:,manual:

DERIBIT_BASE_URL=https://test.deribit.com/api/v2
DERIBIT_WS_URL=wss://test.deribit.com/ws/api/v2
