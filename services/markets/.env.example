APP_ENV=dev
API_ADDR=:8080
DATABASE_URL=postgres://postgres:postgres@localhost:5432/matching?sslmode=disable
MATCHER_POLL_INTERVAL=250ms

CHAIN_RPC_URL=
CHAIN_ID=
MATCHING_ADDRESS=
ENFORCE_MATCHING_CUSTODY=true
ENFORCE_ACTION_DATA_INVARIANTS=true
TRADE_MODULE_ADDRESS=
CNGN_SPOT_ASSET_ADDRESS=
# CashAsset contract. Required for the pre-trade funding check: a buyer must hold
# notional + taker fee, because TradeModule puts the fee in the same batch and the SRM
# checks cash >= 0 on the net delta. Unset disables the check (matching still works;
# underfunded buys just revert on chain instead of being skipped).
CASH_ASSET_ADDRESS=
ENFORCE_FUNDING_CHECK=true

EXPECTED_ORDER_OWNER=
EXPECTED_ORDER_SIGNER=

EXECUTOR_URL=http://localhost:3001/match
EXECUTOR_MANAGER_DATA=0x
CANCEL_PROTECTED_ORDER_ID_PREFIXES=validation:,smoke:,manual:

DERIBIT_BASE_URL=https://test.deribit.com/api/v2
DERIBIT_WS_URL=wss://test.deribit.com/ws/api/v2
